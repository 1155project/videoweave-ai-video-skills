#!/usr/bin/env python3
"""videoweave-upload — upload a local file to VideoWeave via a presigned URL.

Usage:
    videoweave-upload --url "<presigned_url>" --file "/path/to/file.mp4"

Get the presigned URL by calling the MCP tool `prepare_upload` in your AI session.
The file_id is already registered — no further action is needed after this script
completes successfully.

Requirements:
    pip install requests

Cross-platform: works on macOS, Linux, and Windows.
"""

import argparse
import os
import sys

try:
    import requests
except ImportError:
    print("Error: 'requests' package is required.")
    print("Install it with:  pip install requests")
    sys.exit(1)


def _human_size(n_bytes: int) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n_bytes < 1024:
            return f"{n_bytes:.1f} {unit}"
        n_bytes /= 1024
    return f"{n_bytes:.1f} TB"


def upload(url: str, file_path: str, chunk_size: int = 1024 * 1024) -> None:
    if not os.path.isfile(file_path):
        print(f"Error: file not found: {file_path}")
        sys.exit(1)

    file_size = os.path.getsize(file_path)
    filename = os.path.basename(file_path)

    print(f"Uploading {filename} ({_human_size(file_size)}) ...")

    uploaded = 0
    last_pct = -1

    def _stream():
        nonlocal uploaded, last_pct
        with open(file_path, "rb") as fh:
            while True:
                chunk = fh.read(chunk_size)
                if not chunk:
                    break
                uploaded += len(chunk)
                pct = int(uploaded / file_size * 100)
                if pct != last_pct:
                    bar = "#" * (pct // 2) + "." * (50 - pct // 2)
                    print(f"\r  [{bar}] {pct:3d}%  {_human_size(uploaded)}/{_human_size(file_size)}", end="", flush=True)
                    last_pct = pct
                yield chunk

    headers = {
        "Content-Type": "application/octet-stream",
        "Content-Length": str(file_size),
    }

    response = requests.put(url, data=_stream(), headers=headers, timeout=3600)
    print()  # newline after progress bar

    if response.status_code in (200, 204):
        print(f"Upload complete: {filename}")
    else:
        print(f"Upload failed — HTTP {response.status_code}")
        print(f"Response: {response.text[:500]}")
        sys.exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Upload a local file to VideoWeave using a presigned URL.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Example:\n"
            "  videoweave-upload --url 'https://...' --file ~/clips/clip01.mp4\n\n"
            "Get the presigned URL by calling `prepare_upload` via the VideoWeave MCP server."
        ),
    )
    parser.add_argument("--url", required=True, metavar="URL",
                        help="Presigned upload URL from the prepare_upload MCP tool")
    parser.add_argument("--file", required=True, metavar="PATH",
                        help="Local path to the file to upload")
    parser.add_argument("--chunk-size", type=int, default=1024 * 1024, metavar="BYTES",
                        help="Upload chunk size in bytes (default: 1048576 = 1 MB)")
    args = parser.parse_args()

    upload(url=args.url, file_path=os.path.expanduser(args.file), chunk_size=args.chunk_size)


if __name__ == "__main__":
    main()
